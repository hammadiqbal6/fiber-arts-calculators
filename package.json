{
  "name": "fiber-arts-calculators",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Free knitting, crochet, sewing & quilting calculators — yarn, gauge, fabric, quilt tools",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/generate-og.mjs && astro build",
    "og": "node scripts/generate-og.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm run build && node scripts/audit/run-all.mjs",
    "audit:seo": "node scripts/audit/seo-audit.mjs",
    "audit:checklist": "node scripts/audit/page-checklist.mjs",
    "audit:adsense": "node scripts/audit/adsense-audit.mjs",
    "audit:budget": "node scripts/audit/js-budget.mjs",
    "audit:links": "node scripts/audit/link-check.mjs",
    "lhci": "lhci autorun",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "proof": "node scripts/proof/generate-proof.mjs",
    "proof:verify": "node scripts/proof/verify-proof.mjs",
    "check-links": "node scripts/audit/link-check.mjs",
    "deploy": "npx wrangler deploy",
    "indexnow": "node scripts/indexnow.mjs",
    "deploy:indexnow": "npm run deploy && node scripts/indexnow.mjs"
  },
  "dependencies": {
    "astro": "^5.7.10"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@types/node": "^22.13.10",
    "lighthouse": "^12.6.1",
    "playwright": "^1.64.1",
    "serve": "^14.2.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=20 <25"
  }
}
