# Copy to `.env` for local overrides. Astro bakes PUBLIC_* into the client at build time.
# Cloudflare Workers Builds: set the same PUBLIC_* keys as build environment variables.
# No secrets — every value here is safe to commit or paste into the dashboard.

# Canonical site origin (no trailing slash) for canonicals, sitemap, robots, OG, IndexNow host.
PUBLIC_SITE_URL=https://fiber-arts-calculators.hammadiqbal117.workers.dev

# Sister-site origins (no trailing slash). Same names on all five repos; switch when custom domains arrive.
# Used for cross-site “related tools” / About links via src/config/sister-sites.ts.
PUBLIC_SITE_URL_PAYMENT_FEES=https://payment-fee-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_BUSINESS_DOCS=https://business-document-generators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_HOME_GARDEN=https://home-garden-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_FIBER_ARTS=https://fiber-arts-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_PET=https://pet-calculators.hammadiqbal117.workers.dev

# Brand name in nav, footer, and schema.
PUBLIC_SITE_NAME=FiberCalc

# Public contact address (footer, Contact/Privacy/Terms, Organization JSON-LD).
PUBLIC_CONTACT_EMAIL=hammadiqbal117@gmail.com

# Legal / publisher name for Privacy, Terms, Organization schema.
PUBLIC_LEGAL_NAME=FiberCalc

# Author display name on /about/#maintainer and tool/guide bylines (default: Hammad Iqbal).
PUBLIC_AUTHOR_NAME=Hammad Iqbal

# Author bio on /about/ (honest, no fake credentials; override to customize).
PUBLIC_AUTHOR_BIO=Full-stack developer who builds free, in-browser calculators. I maintain FiberCalc as a one-person project: every formula and Craft Yarn Council citation on these pages is checked by me. I am not a professional knitting instructor, pattern designer, or textile engineer.

# Google AdSense publisher ID (pub-…). Leave empty until approved; keep ads off.
PUBLIC_ADSENSE_PUBLISHER_ID=

# Set to true only when publisher ID + ads.txt are ready (default: false).
PUBLIC_ADSENSE_ENABLED=false

# Google Analytics 4 measurement ID (loads gtag.js when set).
PUBLIC_GA4_MEASUREMENT_ID=G-ZBG3Q84R75

# Google Search Console HTML-tag verification content value.
PUBLIC_GSC_VERIFICATION=0-q_NxhBgfgCm4WOLfbe9VrHrjbLzaxh8SXsbo2Q-UU

# Legacy alias for PUBLIC_GSC_VERIFICATION (same meta tag). Prefer PUBLIC_GSC_VERIFICATION.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta verification content (optional).
PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key for siteConfig / docs (must match public/<key>.txt). Prefer INDEXNOW_KEY for the ping script.
PUBLIC_INDEXNOW_KEY=9638154d8d3e54b9c2ce62eb17469c43

# Twitter/X handle for cards, including @ (optional).
PUBLIC_TWITTER_HANDLE=

# --- scripts/indexnow.mjs (Node process.env; not baked into HTML) ---

# IndexNow API key override for the post-deploy ping (default: committed key above).
INDEXNOW_KEY=9638154d8d3e54b9c2ce62eb17469c43

# Set to 1 to skip the IndexNow ping (script still exits 0).
INDEXNOW_DISABLE=
