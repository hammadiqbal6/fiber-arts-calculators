# Copy to `.env` for local overrides. Astro bakes PUBLIC_* into the client at build time.
# Cloudflare Workers Builds: set the same keys as build environment variables (no secrets here).

# Canonical site origin, no trailing slash. Required for SEO (canonicals, sitemap, robots, OG).
# Example: https://fiber-arts-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL=

# Brand name in nav, footer, and schema. Optional (default: FiberCalc).
PUBLIC_SITE_NAME=

# Public contact address (footer, contact, privacy). Recommended before AdSense.
# Example: hello@example.com
PUBLIC_CONTACT_EMAIL=

# Legal / publisher name for Privacy, Terms, Organization schema. Optional (default: FiberCalc).
PUBLIC_LEGAL_NAME=

# Google AdSense publisher ID. Optional until monetizing. Example: pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_PUBLISHER_ID=

# Set to true only when publisher ID + ads.txt are ready. Optional (default: false).
PUBLIC_ADSENSE_ENABLED=

# Google Analytics 4 measurement ID. Optional; empty/unset = no gtag.js on any page.
# Example: G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console HTML tag content value. Optional.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta verification content. Optional.
PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key string (also host /{key}.txt). Optional; used by scripts/indexnow.mjs.
PUBLIC_INDEXNOW_KEY=

# Twitter/X handle for cards, including @. Optional. Example: @fibercalc
PUBLIC_TWITTER_HANDLE=
