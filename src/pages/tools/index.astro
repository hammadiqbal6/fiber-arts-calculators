---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { TOOLS } from '../../lib/tools';
import { siteConfig } from '../../config/site';

const title = 'All Fiber Arts Calculators';
const description = 'Complete list of free FiberCalc knitting, crochet, sewing, quilting, and cross-stitch calculators.';
---

<BaseLayout title={title} description={description} canonicalPath="/tools/">
  <div class="container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools' }]} />
    <h1>All calculators</h1>
    <p>Every {siteConfig.siteName} tool runs in your browser with inches/cm, yards/meters, and grams/oz where relevant.</p>
    <div class="tool-grid">
      {TOOLS.map((t) => (
        <a class="tool-link" href={t.path}>
          <h2>{t.title}</h2>
          <p>{t.description}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
