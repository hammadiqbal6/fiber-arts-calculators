---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { YARN_WEIGHTS } from '../../lib/reference/yarn-weights';
import { siteConfig } from '../../config/site';
import { CANONICAL_PERSON_ID } from '../../config/site';

const title = 'CYC Yarn Weight Standards';
const description =
  'CYC yarn weight categories 0–7 with knit/crochet gauge ranges, needle and hook sizes, and source links. Mobile-friendly table with scroll.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${siteConfig.siteUrl}/reference/yarn-weights/#page`,
      name: title,
      description,
      url: `${siteConfig.siteUrl}/reference/yarn-weights/`,
      author: { '@id': CANONICAL_PERSON_ID },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteConfig.siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Reference', item: `${siteConfig.siteUrl}/reference/` },
        { '@type': 'ListItem', position: 3, name: 'Yarn weights', item: `${siteConfig.siteUrl}/reference/yarn-weights/` },
      ],
    },
    {
      '@type': 'Dataset',
      name: 'CYC Standard Yarn Weight System (summary)',
      description: 'Summary table of Craft Yarn Council yarn weight categories 0–7 with typical gauges.',
      url: `${siteConfig.siteUrl}/reference/yarn-weights/`,
      creator: { '@type': 'Organization', name: 'Craft Yarn Council' },
      citation: 'https://www.craftyarncouncil.com/standards/yarn-weight-system',
    },
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath="/reference/yarn-weights/" jsonLd={jsonLd}>
  <div class="container prose">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Reference', href: '/reference/' }, { label: 'Yarn weights' }]} />
    <h1>Craft Yarn Council yarn weight standards</h1>
    <div class="takeaway">
      <p><strong>Key takeaway:</strong> CYC labels yarn categories 0 (Lace) through 7 (Jumbo)—category 4 (worsted / medium) is the default in most FiberCalc yarn tools, including the ~1,815 yd throw example. Use the category number on the ball band when estimating yardage.</p>
    </div>
    <p class="meta-row"><span>Last reviewed {siteConfig.lastReviewed}</span></p>
    <p>The table below summarizes publicly documented CYC ranges plus FiberCalc planning midpoints for yards per 100 g (site heuristic for substitution math—not a CYC publication). Always confirm the icon and gauge on your specific yarn band—brand naming (especially “DK” vs “worsted”) can vary.</p>

    <figure class="diagram">
      <img
        src="/images/diagram-yarn-weights.svg"
        alt="Diagram of Craft Yarn Council yarn weight categories 0 through 7 showing relative yarn thickness"
        width="1200"
        height="900"
        loading="lazy"
      />
      <figcaption>Redrawn thickness chart for quick scanning. Official ranges: Craft Yarn Council Yarn Weight System.</figcaption>
    </figure>

    <div class="table-scroll" tabindex="0" role="region" aria-label="Yarn weight standards table">
      <table>
        <caption>CYC yarn weight categories with typical knit and crochet gauges</caption>
        <thead>
          <tr>
            <th>#</th><th>Name</th><th>WPI</th><th>Knit sts/4″</th><th>Needles mm</th><th>Crochet sc/4″</th><th>Hooks mm</th><th>yd/100 g (mid)</th>
          </tr>
        </thead>
        <tbody>
          {YARN_WEIGHTS.map((y) => (
            <tr>
              <td>{y.id}</td>
              <td>{y.name}</td>
              <td>{y.wpi[0]}–{y.wpi[1]}</td>
              <td>{y.knitGaugeSts4in[0]}–{y.knitGaugeSts4in[1]}</td>
              <td>{y.needleMetricMm[0]}–{y.needleMetricMm[1]}</td>
              <td>{y.crochetGaugeSc4in[0]}–{y.crochetGaugeSc4in[1]}</td>
              <td>{y.hookMetricMm[0]}–{y.hookMetricMm[1]}</td>
              <td>{Math.round((y.yardsPer100g[0] + y.yardsPer100g[1]) / 2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <h2>How to use this chart with FiberCalc</h2>
    <p>
      Match the CYC icon on the ball band to the “#” column, then enter that weight in a yarn calculator.
      The yd/100 g midpoint feeds the <a href="/tools/yarn-substitution-calculator/">yarn substitution calculator</a>
      when a skein omits length. Project densities (yards per square inch) live on
      <a href="/methodology/#yarn-density">Methodology</a>—they are FiberCalc heuristics, not CYC figures.
    </p>
    <h2>Typical projects by category</h2>
    <ul>
      <li><strong>0–2</strong> — lace shawls, socks, fine baby garments</li>
      <li><strong>3–4</strong> — sweaters, blankets, hats, amigurumi (DK/worsted defaults)</li>
      <li><strong>5–7</strong> — quick throws, chunky cowls, arm-knit statement pieces</li>
    </ul>
    <h2>Sources</h2>
    <ul>
      <li><a href="https://www.craftyarncouncil.com/standards/yarn-weight-system" rel="noopener noreferrer">Craft Yarn Council — Standard Yarn Weight System</a> (checked {siteConfig.lastReviewed})</li>
      <li><a href="https://www.craftyarncouncil.com/standards/hooks-and-needles" rel="noopener noreferrer">Craft Yarn Council — Hooks &amp; Needles</a> (checked {siteConfig.lastReviewed})</li>
      <li><a href="/methodology/#yarn-density">FiberCalc methodology — yarn density factors</a> (site heuristic)</li>
    </ul>
    <p>
      Related:
      <a href="/tools/yarn-substitution-calculator/">yarn substitution calculator</a>,
      <a href="/tools/needle-hook-converter/">needle &amp; hook converter</a>,
      <a href="/guides/yarn-substitution-basics/">yarn substitution basics</a>,
      <a href="/guides/crochet-hook-size-conversion-chart/">hook size conversion chart</a>,
      <a href="/guides/how-much-yarn-for-a-blanket/">blanket yarn guide</a>,
      <a href="/guides/how-much-yarn-for-a-sweater/">sweater yarn guide</a>,
      <a href="/guides/how-much-yarn-for-amigurumi/">amigurumi yarn guide</a>.
    </p>
  </div>
</BaseLayout>
