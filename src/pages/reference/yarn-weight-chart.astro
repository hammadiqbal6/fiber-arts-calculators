---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { YARN_WEIGHTS } from '../../data/yarn-weights';
import { siteConfig } from '../../config/site';
---

<BaseLayout
  title="Yarn Weight Chart (CYC Standards)"
  description="Craft Yarn Council yarn weight categories 0–7 with knitting and crochet gauge ranges, needle and hook sizes."
  canonicalPath="/reference/yarn-weight-chart/"
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Reference', href: '/reference/' },
      { label: 'Yarn weight chart' },
    ]}
  />
  <h1 class="page-title">Yarn weight chart</h1>
  <div class="answer-box">
    <p>
      The Craft Yarn Council Standard Yarn Weight System labels yarn from 0 (lace) to 7 (jumbo) with typical gauges and needle/hook ranges.
      Use this chart with our <a href="/tools/yarn-blanket-calculator/">yarn calculators</a> and
      <a href="/tools/yarn-substitution-calculator/">substitution tool</a>. Updated {siteConfig.contentUpdated}.
    </p>
  </div>
  <div class="prose">
    <div style="overflow-x:auto">
      <table>
        <thead>
          <tr>
            <th>CYC</th>
            <th>Name</th>
            <th>Knit gauge (sts/4")</th>
            <th>US needles</th>
            <th>Crochet gauge (sc/4")</th>
            <th>US hooks</th>
          </tr>
        </thead>
        <tbody>
          {
            YARN_WEIGHTS.map((y) => (
              <tr>
                <td>{y.category}</td>
                <td>{y.name}</td>
                <td>
                  {y.knitGaugeStsPer4in[0]}–{y.knitGaugeStsPer4in[1]}
                </td>
                <td>{y.usNeedles}</td>
                <td>
                  {y.crochetGaugeScPer4in[0]}–{y.crochetGaugeScPer4in[1]}
                </td>
                <td>{y.usHooks}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <h2>Source</h2>
    <p>
      <a href="https://www.craftyarncouncil.com/standards/yarn-weight-system" rel="noopener noreferrer"
        >Craft Yarn Council — Standard Yarn Weight System</a
      >. Category averages for calculator density factors are planning aids, not brand-specific put-ups.
    </p>
  </div>
</BaseLayout>
