---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title="About FiberCalc" description="About FiberCalc — free client-side knitting, crochet, sewing, and quilting calculators for makers." canonicalPath="/about/">
  <div class="container prose">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
    <h1>About {siteConfig.siteName}</h1>
    <p>{siteConfig.siteName} is a free toolkit for fiber artists: yarn estimators, gauge math, fabric yardage, quilt backing and binding, HST cutting, cross-stitch fabric sizing, and needle/hook conversion.</p>
    <p>Every calculator runs entirely in your browser. We do not require accounts and we do not upload your project measurements.</p>
    <h2>Editorial approach</h2>
    <p>We document formulas, cite Craft Yarn Council standards where relevant, and show worked examples. Read our <a href="/methodology/">methodology</a> and <a href="/authors/">authors</a> pages for E-E-A-T details.</p>
    <p>Contact: <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></p>
  </div>
</BaseLayout>
