---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';

const title = 'Contact FiberCalc';
const description =
  'Email FiberCalc about calculator questions, formula corrections, source updates, or partnership inquiries. Include the tool URL when reporting math issues.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${siteConfig.siteUrl}/contact/#page`,
      name: title,
      description,
      url: `${siteConfig.siteUrl}/contact/`,
      isPartOf: { '@id': `${siteConfig.siteUrl}/#website` },
      author: { '@id': 'https://github.com/hammadiqbal6#person' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteConfig.siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Contact', item: `${siteConfig.siteUrl}/contact/` },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath="/contact/" jsonLd={jsonLd}>
  <div class="container prose">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
    <h1>Contact</h1>
    <p>
      Email us at <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> with questions about
      the calculators, corrections to formulas or Craft Yarn Council citations, or partnership inquiries. This page is
      form-ready: you can replace the mailto with a static form endpoint when you deploy.
    </p>
    <p>
      Please include the tool URL and the inputs you used if you are reporting a calculation issue. We welcome source
      corrections with links to authoritative references such as CYC standards pages.
    </p>
    <p>
      <strong>Do not send personal projects or photos that must remain private</strong>—we do not need files to debug
      math questions. All calculator arithmetic already runs in your browser.
    </p>
  </div>
</BaseLayout>
