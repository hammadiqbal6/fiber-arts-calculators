---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';

const title = 'Contact FiberCalc — Questions and Corrections';
const description =
  'Email FiberCalc about calculator questions, formula corrections, source updates, or partnership inquiries. Include the tool URL when reporting math issues.';

const { serviceId: emailjsServiceId, templateId: emailjsTemplateId, publicKey: emailjsPublicKey } =
  siteConfig.emailjs;
const emailjsReady = Boolean(emailjsServiceId && emailjsTemplateId && emailjsPublicKey);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${siteConfig.siteUrl}/contact/#page`,
      name: title,
      description,
      url: `${siteConfig.siteUrl}/contact/`,
      isPartOf: { '@id': `${siteConfig.siteUrl}/#website` },
      author: { '@id': 'https://github.com/hammadiqbal6#person' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteConfig.siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Contact', item: `${siteConfig.siteUrl}/contact/` },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath="/contact/" jsonLd={jsonLd}>
  <div class="container prose">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
    <h1>Contact</h1>
    <p class="meta-row"><span>Maintainer: {siteConfig.defaultAuthor.name}</span></p>
    <p>
      Questions about the calculators, corrections to formulas or Craft Yarn Council citations, or partnership
      inquiries are welcome. Please include the tool URL and the inputs you used if you are reporting a calculation
      issue. We welcome source corrections with links to authoritative references such as CYC standards pages.
    </p>
    <p>
      <strong>Do not send personal projects or photos that must remain private</strong>—we do not need files to debug
      math questions. All calculator arithmetic already runs in your browser.
    </p>
    <h2>What to include in a correction</h2>
    <ul>
      <li>The page URL (for example <code>/tools/yarn-blanket-calculator/</code>).</li>
      <li>The inputs you entered and the result you saw.</li>
      <li>The result you expected, with a primary-source link when the claim is about a standard or rate.</li>
    </ul>
    <h2>Response expectations</h2>
    <p>
      This is a one-person project. I aim to reply to formula and citation reports, and I log material fixes on the
      <a href="/methodology/#corrections">methodology correction log</a>. Feature ideas are welcome; there is no
      guaranteed roadmap. For privacy questions, see the <a href="/privacy/">privacy policy</a>; for planning-use
      limits, see the <a href="/terms/">terms of use</a>. Learn who maintains the site on
      <a href="/about/">About</a>.
    </p>
    <h2>Partnerships and ads</h2>
    <p>
      For AdSense, sponsorship, or sister-site directory questions, email with a clear subject line. We do not accept
      guest posts that are unrelated to knitting, crochet, sewing, or quilting planning math. Link suggestions should
      point at primary standards (for example Craft Yarn Council charts) or clearly useful maker resources—not thin
      doorway pages.
    </p>
    <h2>Where to look before writing</h2>
    <p>
      Many “how does this number work?” questions are already answered on the tool page Formula section,
      <a href="/methodology/">Methodology</a>, or a paired guide from the <a href="/guides/">guides index</a>. Checking
      those first helps you send a sharper correction if something still looks wrong.
    </p>

    {
      emailjsReady ? (
        <div
          class="contact-form-panel calculator-shell"
          data-contact-form
          data-service-id={emailjsServiceId}
          data-template-id={emailjsTemplateId}
          data-public-key={emailjsPublicKey}
          data-site-name={siteConfig.siteName}
        >
          <h2 class="contact-form-heading">Send a message</h2>
          <form class="contact-form" novalidate>
            <div class="field">
              <label for="contact-name">Name</label>
              <input id="contact-name" name="from_name" type="text" autocomplete="name" required maxlength="120" />
            </div>
            <div class="field">
              <label for="contact-email">Email</label>
              <input
                id="contact-email"
                name="reply_to"
                type="email"
                autocomplete="email"
                required
                maxlength="200"
                inputmode="email"
              />
            </div>
            <div class="field full">
              <label for="contact-message">Message</label>
              <textarea
                id="contact-message"
                name="message"
                required
                maxlength="2000"
                rows="6"
                aria-describedby="contact-message-hint"
              ></textarea>
              <p id="contact-message-hint" class="field-hint">Up to 2,000 characters.</p>
            </div>
            {/* Honeypot — leave empty; hidden from assistive tech */}
            <div class="visually-hidden" aria-hidden="true">
              <label for="contact-company">Company</label>
              <input
                id="contact-company"
                name="company"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <div class="btn-row full">
              <button type="submit" class="btn btn--primary" data-contact-submit>Send message</button>
            </div>
            <p class="contact-form-status" data-contact-status role="status" aria-live="polite"></p>
          </form>
          <noscript>
            <p>
              JavaScript is required to send this form. Email{' '}
              <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> instead.
            </p>
          </noscript>
        </div>
      ) : (
        <p>
          Email us at <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
        </p>
      )
    }

    <p class="contact-mailto-secondary">
      Or email directly:{' '}
      <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
    </p>
  </div>

  {
    emailjsReady && (
      <script>
        import { initContactForm } from '../scripts/contact-form';
        const el = document.querySelector('[data-contact-form]');
        if (el instanceof HTMLElement) initContactForm(el);
      </script>
    )
  }
</BaseLayout>
