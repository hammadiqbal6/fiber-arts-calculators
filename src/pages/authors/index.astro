---
/**
 * Canonical author URL is /about/#maintainer (playbook).
 * This page exists so old /authors/ links still work, then we redirect via meta + link.
 * Prefer the 301 in public/_redirects when deployed on Workers assets.
 */
import BaseLayout from '../../components/BaseLayout.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout
  title="Authors"
  description={`Author information for ${siteConfig.siteName} redirects to the About page maintainer section.`}
  canonicalPath="/about/"
  noindex={true}
>
  <div class="container prose">
    <h1>Authors</h1>
    <p>
      {siteConfig.siteName} is maintained by one person,
      <a href="/about/#maintainer">{siteConfig.defaultAuthor.name}</a>.
      This authors index redirects there.
    </p>
    <meta http-equiv="refresh" content="0;url=/about/#maintainer" />
    <script is:inline>
      location.replace('/about/#maintainer');
    </script>
  </div>
</BaseLayout>
