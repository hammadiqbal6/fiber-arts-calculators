---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout title="Authors & Reviewers" description="Author and reviewer bios for FiberCalc editorial content and calculator documentation." canonicalPath="/authors/">
  <div class="container prose">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Authors' }]} />
    <h1>Authors &amp; reviewers</h1>
    <h2>{siteConfig.defaultAuthor.name}</h2>
    <p>Role: {siteConfig.defaultAuthor.role}.</p>
    <p>{siteConfig.defaultAuthor.bio}</p>
  </div>
</BaseLayout>
