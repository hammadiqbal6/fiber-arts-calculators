---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES, toolsByCategory } from '../../data/tools';

const cat = CATEGORIES.crochet;
const tools = toolsByCategory('crochet');
---

<BaseLayout
  title="Crochet Calculators"
  description="Free crochet calculators for blanket stitch counts, amigurumi yarn, and related yarn planning tools."
  canonicalPath={cat.path}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Crochet' }]} />
  <h1 class="page-title">Crochet calculators</h1>
  <div class="answer-box">
    <p>
      Plan crochet blankets from gauge to starting chain, estimate amigurumi yarn by height, and jump to shared yarn substitution and hook size tools.
    </p>
  </div>
  <p class="lead">{cat.description}</p>
  <ul class="tool-cards">
    {
      tools.map((t) => (
        <li>
          <a href={t.path}>
            <strong>{t.title}</strong>
            <span>{t.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="related">
    <h2>Also useful</h2>
    <ul>
      <li><a href="/tools/yarn-blanket-calculator/">Yarn blanket calculator</a></li>
      <li><a href="/tools/needle-hook-size-converter/">Hook size converter</a></li>
      <li><a href="/guides/crochet-blanket-sizes/">Crochet blanket sizes guide</a></li>
    </ul>
  </div>
</BaseLayout>
