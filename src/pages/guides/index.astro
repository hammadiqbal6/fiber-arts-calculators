---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { GUIDES } from '../../data/guides';
import { siteConfig, CANONICAL_PERSON_ID } from '../../config/site';
import { collectionPageGraph } from '../../lib/schema';

const title = 'Fiber Arts Guides';
const description =
  'Guides on yarn amounts, knitting gauge, quilt backing, HST math, fabric yardage, and yarn substitution—each paired with free FiberCalc calculators.';

const jsonLd = [
  collectionPageGraph({
    name: title,
    description,
    path: '/guides/',
    crumbs: [
      { name: 'Home', path: '/' },
      { name: 'Guides', path: '/guides/' },
    ],
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: GUIDES.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.title,
      url: `${siteConfig.siteUrl}/guides/${g.slug}/`,
    })),
    author: { '@id': CANONICAL_PERSON_ID },
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/guides/" jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
    <h1>Guides</h1>
    <p class="answer-first">
      Practical articles with charts and worked numbers—for example, a 50×60″ worsted knit throw is about 1,815 yards
      on the FiberCalc model—then link to the matching calculator.
    </p>
    <div class="tool-grid">
      {GUIDES.map((g) => (
        <a class="tool-link" href={`/guides/${g.slug}/`}>
          <h2>{g.title}</h2>
          <p>{g.description}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
