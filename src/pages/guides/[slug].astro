---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { GUIDES } from '../../data/guides';
import { siteConfig, CANONICAL_PERSON_ID } from '../../config/site';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug } }));
}

const guide = GUIDES.find((g) => g.slug === Astro.params.slug)!;
const path = `/guides/${guide.slug}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    datePublished: `${guide.datePublished}T00:00:00+05:00`,
    dateModified: `${guide.dateModified}T00:00:00+05:00`,
    author: [
      {
        '@type': 'Person',
        '@id': CANONICAL_PERSON_ID,
        name: siteConfig.defaultAuthor.name,
        url: `${siteConfig.siteUrl}/about/`,
      },
    ],
    publisher: {
      '@type': 'Organization',
      name: siteConfig.siteName,
      url: `${siteConfig.siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${siteConfig.siteUrl}/logo-512.png`,
        width: 512,
        height: 512,
      },
    },
    mainEntityOfPage: siteConfig.siteUrl + path,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: siteConfig.siteUrl + '/guides/' },
      { '@type': 'ListItem', position: 3, name: guide.title, item: siteConfig.siteUrl + path },
    ],
  },
];
---

<BaseLayout title={guide.title} description={guide.description} canonicalPath={path} jsonLd={jsonLd}>
  <div class="container prose">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Guides', href: '/guides/' },
      { label: guide.title },
    ]} />
    <h1>{guide.title}</h1>
    <div class="meta-row">
      <span>Published {guide.datePublished}</span>
      <span>Updated {guide.dateModified}</span>
      <span>By <a href="/about/#maintainer" rel="author">{siteConfig.defaultAuthor.name}</a></span>
    </div>
    {guide.sections.map((block) => {
      if (block.type === 'takeaway') return <div class="takeaway"><p><strong>Key takeaway:</strong> {block.content}</p></div>;
      if (block.type === 'h2') return <h2>{block.content}</h2>;
      if (block.type === 'ul') return <ul>{(block.content as string[]).map((li) => <li>{li}</li>)}</ul>;
      return <p>{block.content}</p>;
    })}
    <RelatedTools slugs={guide.relatedTools} title="Calculators used in this guide" />
  </div>
</BaseLayout>
