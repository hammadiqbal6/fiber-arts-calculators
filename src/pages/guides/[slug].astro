---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import { GUIDES } from '../../data/guides';
import { siteConfig, CANONICAL_PERSON_ID } from '../../config/site';
import { linkifyGuideHtml, stripGuidePaths } from '../../lib/guide-links';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug } }));
}

const guide = GUIDES.find((g) => g.slug === Astro.params.slug)!;
const path = `/guides/${guide.slug}/`;
const ogImage = `/og/${guide.slug}.png`;

const takeaway = guide.sections.find((b) => b.type === 'takeaway');
const bodySections = guide.sections.filter((b) => b.type !== 'takeaway');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    datePublished: `${guide.datePublished}T00:00:00+05:00`,
    dateModified: `${guide.dateModified}T00:00:00+05:00`,
    author: [
      {
        '@type': 'Person',
        '@id': CANONICAL_PERSON_ID,
        name: siteConfig.defaultAuthor.name,
        url: `${siteConfig.siteUrl}/about/`,
      },
    ],
    publisher: {
      '@type': 'Organization',
      name: siteConfig.siteName,
      url: `${siteConfig.siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${siteConfig.siteUrl}/logo-512.png`,
        width: 512,
        height: 512,
      },
    },
    mainEntityOfPage: siteConfig.siteUrl + path,
    image: `${siteConfig.siteUrl}${ogImage}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: siteConfig.siteUrl + '/guides/' },
      { '@type': 'ListItem', position: 3, name: guide.title, item: siteConfig.siteUrl + path },
    ],
  },
  ...(guide.faqs?.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: guide.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: stripGuidePaths(f.a) },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  canonicalPath={path}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageAlt={`${guide.title} — FiberCalc guide`}
>
  <div class="container prose">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Guides', href: '/guides/' },
      { label: guide.title },
    ]} />
    <h1>{guide.title}</h1>

    {takeaway && (
      <div class="takeaway">
        <p>
          <strong>Key takeaway:</strong>{' '}
          <span set:html={linkifyGuideHtml(String(takeaway.content))} />
        </p>
      </div>
    )}

    <div class="meta-row">
      <span>Published {guide.datePublished}</span>
      <span>Updated {guide.dateModified}</span>
      <span>By <a href="/about/#maintainer" rel="author">{siteConfig.defaultAuthor.name}</a></span>
    </div>

    {guide.relatedTools?.length > 0 && (
      <p class="guide-cta">
        <a class="btn btn--secondary" href={`/tools/${guide.relatedTools[0]}/`}>Calculate yours →</a>
      </p>
    )}

    {bodySections.map((block) => {
      if (block.type === 'h2') return <h2>{block.content}</h2>;
      if (block.type === 'ul') {
        return (
          <ul>
            {(block.content as string[]).map((li) => (
              <li set:html={linkifyGuideHtml(li)} />
            ))}
          </ul>
        );
      }
      if (block.type === 'table') {
        const table = block.content as { headers: string[]; rows: string[][]; caption?: string };
        return (
          <div class="table-scroll">
            <table>
              {table.caption && <caption>{table.caption}</caption>}
              <thead>
                <tr>
                  {table.headers.map((h) => (
                    <th scope="col">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {table.rows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td set:html={linkifyGuideHtml(cell)} />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );
      }
      return <p set:html={linkifyGuideHtml(String(block.content))} />;
    })}

    {guide.faqs?.length > 0 && (
      <>
        <h2>FAQ</h2>
        <div class="faq">
          {guide.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p set:html={linkifyGuideHtml(f.a)} />
            </details>
          ))}
        </div>
      </>
    )}

    {guide.sources && guide.sources.length > 0 && (
      <>
        <h2>Sources</h2>
        <ol class="refs">
          {guide.sources.map(([label, href]) => (
            <li>
              <a href={href} rel="noopener noreferrer">{label}</a>
            </li>
          ))}
        </ol>
      </>
    )}

    <RelatedTools slugs={guide.relatedTools} title="Calculators used in this guide" />
    <RelatedGuides slugs={guide.relatedGuides || []} title="Related guides" />
  </div>
</BaseLayout>
