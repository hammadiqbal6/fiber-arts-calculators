---
import { siteConfig } from '../config/site';

interface Props {
  variant?: 'in-article' | 'footer' | 'sidebar';
}

const { variant = 'in-article' } = Astro.props;
const enabled = siteConfig.adsense.enabled && Boolean(siteConfig.adsense.client);
const slot =
  variant === 'sidebar' ? siteConfig.adsense.slots.sidebar : siteConfig.adsense.slots.inArticle;
---

<aside class:list={['ad-slot', { 'ad-slot--disabled': !enabled }]} aria-label="Advertisement">
  {
    enabled && slot ? (
      <ins
        class="adsbygoogle"
        style="display:block;width:100%;min-height:90px"
        data-ad-client={siteConfig.adsense.client}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
    ) : (
      <span>Ad space reserved ({variant}) — configure publisher ID to enable</span>
    )
  }
</aside>

{
  enabled && (
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsense.client}`}
      crossorigin="anonymous"
    />
  )
}
