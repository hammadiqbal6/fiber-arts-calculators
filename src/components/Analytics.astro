---
import { siteConfig } from '../config/site';
const gaId = siteConfig.ga4MeasurementId;
---

{gaId && (
  <>
    {/* Consent Mode v2 defaults before any gtag config — inline, non-blocking */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500
      });
    </script>
    {/* Pass gaId without import — define:vars emits a classic script, not a module. */}
    <script is:inline define:vars={{ gaId }}>
      window.__FIBER_GA_ID = gaId;
    </script>
    <script>
      import { scheduleAnalytics, bindOutboundTracking } from '../scripts/analytics';
      const id = window.__FIBER_GA_ID || '';
      if (id) {
        scheduleAnalytics(id);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => bindOutboundTracking());
        } else {
          bindOutboundTracking();
        }
      }
    </script>
  </>
)}
