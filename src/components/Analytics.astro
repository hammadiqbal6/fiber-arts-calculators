---
import { siteConfig } from '../config/site';
const gaId = siteConfig.ga4MeasurementId;
---

{gaId && (
  <>
    {/* Consent Mode v2 defaults before any gtag config — inline, non-blocking */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500
      });
    </script>
    <script define:vars={{ gaId }}>
      import { scheduleAnalytics, bindOutboundTracking } from '../scripts/analytics';
      scheduleAnalytics(gaId);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => bindOutboundTracking());
      } else {
        bindOutboundTracking();
      }
    </script>
  </>
)}
