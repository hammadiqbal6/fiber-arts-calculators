---
import { getTool, type ToolDef } from '../lib/tools';

interface Props {
  slugs: string[];
  title?: string;
}
const { slugs, title = 'Related calculators' } = Astro.props;
const tools = slugs.map((s) => getTool(s)).filter(Boolean) as ToolDef[];
---

{
  tools.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">{title}</h2>
      <div class="tool-grid">
        {tools.map((t) => (
          <a class="tool-link" href={t.path}>
            <h3>{t.title}</h3>
            <p>{t.description}</p>
          </a>
        ))}
      </div>
    </section>
  )
}
