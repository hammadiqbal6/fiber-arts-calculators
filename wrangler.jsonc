{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Pure static-assets Worker (no adapter, no Worker script, no bindings).
  "name": "fiber-arts-calculators",
  // Keep current with Workers best-practice: today's date for new Workers.
  "compatibility_date": "2026-10-19",
  "assets": {
    // Astro `npm run build` output
    "directory": "./dist",
    // Serve nearest 404.html for unknown paths (Astro emits dist/404.html)
    "not_found_handling": "404-page",
    // Match Astro trailingSlash: 'always'
    "html_handling": "force-trailing-slash"
  },
  // PUBLIC_* are build-time (Astro). Set the same keys in Cloudflare Workers Builds
  // dashboard env vars (including PUBLIC_SITE_URL and PUBLIC_SITE_URL_* sister origins).
  // Runtime Worker vars are not used for this static site.
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
